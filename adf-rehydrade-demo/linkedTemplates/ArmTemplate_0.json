		{
			"name": "[concat(parameters('factoryName'), '/Demo-AzCopy-with-ACI')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"description": "Demo-AzCopy-with-ACI  pipeline",
				"activities": [
					{
						"name": "CreateACI-AzCopy",
						"type": "WebActivity",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"method": "PUT",
							"headers": {
								"Content-Type": "application/json"
							},
							"url": "https://management.azure.com/subscriptions/f372dab9-307c-4546-9124-2919fa2d1ad0/resourceGroups/adf-rehydration-demo-rg/providers/Microsoft.ContainerInstance/containerGroups/aci-azcopy-container-grp?api-version=2023-05-01",
							"body": {
								"location": "eastus",
								"identity": {
									"type": "UserAssigned"
								},
								"properties": {
									"osType": "Linux",
									"restartPolicy": "Never",
									"containers": [
										{
											"name": "aci-azcopy-container",
											"properties": {
												"image": "demoazcopycontainer.azurecr.io/azcopy-version:v1",
												"command": [
													"/bin/sh",
													"-c",
													"azcopy login --identity --identity-client-id @{pipeline().parameters.acrPullIdentityClientId} && azcopy copy 'https://rehydarchivestorage219.blob.core.windows.net/archive/file1.csv' 'https://targetrehydstorage219.blob.core.windows.net/targetcontainer/file1.csv'"
												],
												"resources": {
													"requests": {
														"cpu": 1,
														"memoryInGB": 2
													}
												}
											}
										}
									],
									"imageRegistryCredentials": [
										{
											"server": "demoazcopycontainer.azurecr.io",
											"identity": "/subscriptions/f372dab9-307c-4546-9124-2919fa2d1ad0/resourceGroups/adf-rehydration-demo-rg/providers/Microsoft.ManagedIdentity/userAssignedIdentities/id-aci-acrpull"
										}
									]
								}
							},
							"authentication": {
								"type": "MSI",
								"resource": "https://management.azure.com/"
							}
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"parameters": {
					"acrPullIdentityClientId": {
						"type": "string",
						"defaultValue": "6edbe86f-6203-4515-bd7f-ca6bec9e15f9"
					}
				},
				"annotations": []
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/hybrid-worker-az-copy')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "Start-Automation-Runbook",
						"description": "Start-Automation-Runbook",
						"type": "WebActivity",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"method": "PUT",
							"headers": {},
							"url": {
								"value": "https://management.azure.com/subscriptions/f372dab9-307c-4546-9124-2919fa2d1ad0/resourceGroups/adf-rehydration-demo-rg/providers/Microsoft.Automation/automationAccounts/SQLBackupMigrationAutomation/jobs/@{guid()}?api-version=2023-11-01",
								"type": "Expression"
							},
							"body": {
								"properties": {
									"runbook": {
										"name": "test-hybrid-worker-vm"
									},
									"runOn": "BlobCopyWorkers",
									"parameters": {
										"Environment": "DEV"
									}
								}
							},
							"authentication": {
								"type": "MSI",
								"resource": "https://management.azure.com/"
							}
						}
					},
					{
						"name": "Store Job ID",
						"description": "Store Job ID",
						"type": "SetVariable",
						"dependsOn": [
							{
								"activity": "Start-Automation-Runbook",
								"dependencyConditions": [
									"Completed"
								]
							}
						],
						"policy": {
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"variableName": "automationJobId",
							"value": {
								"value": "@activity('Start-Automation-Runbook').output.name",
								"type": "Expression"
							}
						}
					},
					{
						"name": "UntilActivity",
						"type": "Until",
						"dependsOn": [
							{
								"activity": "Store Job ID",
								"dependencyConditions": [
									"Completed"
								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"expression": {
								"value": "@or(\n    or(\n        equals(variables('automationJobStatus'),'Completed'),\n        equals(variables('automationJobStatus'),'Failed')\n    ),\n    or(\n        equals(variables('automationJobStatus'),'Stopped'),\n        equals(variables('automationJobStatus'),'Suspended')\n    )\n)",
								"type": "Expression"
							},
							"activities": [
								{
									"name": "Get Automation Job Status",
									"type": "WebActivity",
									"dependsOn": [],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"method": "GET",
										"headers": {},
										"url": {
											"value": "@concat( 'https://management.azure.com/subscriptions/f372dab9-307c-4546-9124-2919fa2d1ad0/resourceGroups/adf-rehydration-demo-rg/providers/Microsoft.Automation/automationAccounts/SQLBackupMigrationAutomation/jobs/', variables('automationJobId'),'?api-version=2023-11-01' )",
											"type": "Expression"
										},
										"authentication": {
											"type": "MSI",
											"resource": "https://management.azure.com/"
										}
									}
								},
								{
									"name": "Update Job Status",
									"type": "SetVariable",
									"dependsOn": [
										{
											"activity": "Get Automation Job Status",
											"dependencyConditions": [
												"Succeeded"
											]
										}
									],
									"policy": {
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"variableName": "automationJobStatus",
										"value": {
											"value": "@activity('Get Automation Job Status').output.properties.status",
											"type": "Expression"
										}
									}
								},
								{
									"name": "Wait Before Next Check",
									"description": "30",
									"type": "Wait",
									"dependsOn": [
										{
											"activity": "Update Job Status",
											"dependencyConditions": [
												"Succeeded"
											]
										}
									],
									"userProperties": [],
									"typeProperties": {
										"waitTimeInSeconds": 30
									}
								}
							],
							"timeout": "0.12:00:00"
						}
					},
					{
						"name": "If Condition",
						"type": "IfCondition",
						"dependsOn": [
							{
								"activity": "UntilActivity",
								"dependencyConditions": [
									"Completed"
								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"expression": {
								"value": "@equals(\nvariables('automationJobStatus'),\n'Completed'\n)",
								"type": "Expression"
							},
							"ifFalseActivities": [
								{
									"name": "Automation Runbook Failed",
									"type": "Fail",
									"dependsOn": [],
									"userProperties": [],
									"typeProperties": {
										"message": "Azure Automation Runbook failed",
										"errorCode": "AutomationJobFailed"
									}
								}
							]
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"variables": {
					"automationJobId": {
						"type": "String"
					},
					"automationJobStatus": {
						"type": "String"
					}
				},
				"annotations": []
			},
			"dependsOn": []
		},
