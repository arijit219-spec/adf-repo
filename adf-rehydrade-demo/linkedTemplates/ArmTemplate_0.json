			"type": "string",
			"defaultValue": "https://rehydarchivestorage219.blob.core.windows.net/"
		},
		"AzureKeyVault1_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://kv-adf-rehydration.vault.azure.net/"
		},
		"LS_ADLS_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://rehydstorage219.dfs.core.windows.net/"
