{
	"name": "Demo-AzCopy-with-ACI",
	"properties": {
		"description": "Demo-AzCopy-with-ACI  pipeline",
		"activities": [
			{
				"name": "CreateACI-AzCopy",
				"type": "WebActivity",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "PUT",
					"headers": {
						"Content-Type": "application/json"
					},
					"url": "https://management.azure.com/subscriptions/f372dab9-307c-4546-9124-2919fa2d1ad0/resourceGroups/adf-rehydration-demo-rg/providers/Microsoft.ContainerInstance/containerGroups/aci-azcopy-container-grp?api-version=2023-05-01",
					"body": {
						"location": "eastus",
						"properties": {
							"osType": "Linux",
							"restartPolicy": "Never",
							"containers": [
								{
									"name": "aci-azcopy-container",
									"properties": {
										"image": "mcr.microsoft.com/azure-cli:latest",
										"command": [
											"/bin/bash",
											"-c",
											"curl -L https://aka.ms/downloadazcopy-v10-linux -o azcopy.tar.gz && tar -xf azcopy.tar.gz && cp ./azcopy_linux_amd64_*/azcopy /usr/bin/ && azcopy --version"
										],
										"resources": {
											"requests": {
												"cpu": 1,
												"memoryInGB": 2
											}
										}
									}
								}
							]
						}
					},
					"authentication": {
						"type": "MSI",
						"resource": "https://management.azure.com/"
					}
				}
			}
		],
		"annotations": []
	}
}